# Provided automatically by BasicDeploy when deployed there.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PORT=8080

# M-Pesa STK Push is disabled by default. Start with sandbox only.
MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
PUBLIC_BASE_URL=
# Configure these only in private deployment environment settings; never commit real values.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_SECRET=replace-with-a-random-url-safe-value-of-at-least-32-characters
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
